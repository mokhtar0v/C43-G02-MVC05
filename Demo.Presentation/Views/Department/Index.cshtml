@model IEnumerable<DepartmentDTO>
@{
    ViewData["Title"] = "Index";
}
<h1>All Departments</h1>
<br>
<br>
<a class="btn btn-primary" my-3 asp-controller="Department" asp-action="Create">Create Department</a>
<br>
@if (Model?.Any()??false)
{
    <table class="table table-striped table-hover mt-2">
        <thead class="text-center">
            <tr>
                <th scope="col">@Html.DisplayNameFor(d =>d.Code)</th>
                <th scope="col">@Html.DisplayNameFor(d => d.Name)</th>
                <th scope="col">@Html.DisplayNameFor(d => d.Description)</th>
                <th scope="col">@Html.DisplayNameFor(d => d.DateOfCreation)</th>
                <th scope="col">Details </th>
                <th scope="col">Update</th>
                <th scope="col">Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var department in Model)
            {
                <tr>
                    <td>@department.Code</td>
                    <td>@department.Name</td>
                    <td>@department.Description</td>
                    <td>@department.DateOfCreation</td>
                    <td>
                        <a class="btn btn-primary" asp-action="Details" asp-route-id="@department.DeptID">
                            <i class="fas fa-eye"></i> Details
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-success" asp-action="Edit" asp-route-id="@department.DeptID">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@department.DeptID">
                            <i class="fas fa-trash"></i> Delete
                        </a>
                    </td>
               
                
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-3">
        <h2>No Departments Found !!</h2>
    </div>
}

